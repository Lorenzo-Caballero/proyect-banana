<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo">

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Contenedor para cuando un juego pide pantalla completa -->
    <FrameLayout
        android:id="@+id/pantallaCompleta"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

    <!-- Pantalla de carga inicial -->
    <LinearLayout
        android:id="@+id/cargando"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fondo"
        android:gravity="center"
        android:orientation="vertical">

        <!-- El logo. Se usa la version redonda del launcher para no tener que
             mantener una copia aparte: sale del mismo generar_logo.py. -->
        <ImageView
            android:layout_width="128dp"
            android:layout_height="128dp"
            android:src="@mipmap/ic_launcher_round"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:letterSpacing="0.14"
            android:text="@string/app_name"
            android:textAllCaps="true"
            android:textColor="@color/texto"
            android:textSize="21sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/spinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:indeterminateTint="@color/violeta_claro" />
    </LinearLayout>

    <!-- Pantalla de error de red -->
    <LinearLayout
        android:id="@+id/error"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fondo"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sin_conexion"
            android:textColor="@color/texto"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/sin_conexion_detalle"
            android:textColor="@color/texto_suave"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnReintentar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:backgroundTint="@color/violeta"
            android:paddingStart="26dp"
            android:paddingEnd="26dp"
            android:text="@string/reintentar"
            android:textColor="@color/texto" />
    </LinearLayout>

</FrameLayout>
