    // negocio, sin tocar código.
    'FINANZAS_COSTO_POR_FICHA'          => '0.20',    // costo al proveedor, por ficha
    'FINANZAS_UMBRAL_RETIRO_GRANDE'     => '50000',   // alerta amarilla: revisar como rutina
    'FINANZAS_UMBRAL_RETIRO_MUY_GRANDE' => '200000',  // alerta roja: revisión especial

    // Piso de diferencia (retiros - recargas) del período para que un
