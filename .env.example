# Copiar a .env y completar. El .env NO se sube al repo.

# --- API PHP de la cola de altas ---
# DOS cosas que este ejemplo tuvo mal y hacian que el bot no procesara nada:
#
#   - el archivo es altas_cola.php. cola_panel.php quedo ROTO cuando la
#     migracion 07 borro la tabla `jugadores`: responde 500. El propio
#     bot_crear_jugador.py avisa al arrancar si API_URL apunta a otra cosa
#     ("las altas viven en altas_cola.php"), pero para entonces ya perdiste
#     un rato buscando por otro lado.
#   - el prefijo es /gp-api/, no /api/. En el VPS /api/ es de la PLATAFORMA
#     (ahi viven /api/user/login y /api/user/check): pegarle ahi devuelve el
#     HTML del SPA, no JSON.
API_URL=https://TU-DOMINIO.com/gp-api/altas_cola.php
API_KEY=una-clave-larga-y-random

# --- Panel de agentes ---
PANEL_URL=https://agents.ganamosonline.com/user/create-player
LOGIN_URL=https://agents.ganamosonline.com/login

# Credenciales del agente. Este archivo es solo un ejemplo: los valores reales
# van en .env, que esta en .gitignore y NO se sube al repo.
PANEL_USER=tu-usuario
PANEL_PASS=tu-password

# Cada cuantos segundos mira la cola de altas.
#
# 3, no 30. La fila entra a la cola en un momento cualquiera del intervalo,
# asi que el jugador paga LA MITAD de este numero de puro sueño: con 30 eran
# 15 segundos regalados por alta, con alguien mirando "creando tu cuenta" del
# otro lado. Es el mismo default que trae el codigo.
POLL_SEGUNDOS=3
