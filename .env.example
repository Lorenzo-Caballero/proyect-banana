# Copiar a .env y completar. El .env NO se sube al repo.

# --- API PHP de la cola de jugadores ---
API_URL=https://TU-DOMINIO.com/api/cola_panel.php
API_KEY=una-clave-larga-y-random

# --- Panel de agentes ---
PANEL_URL=https://agents.ganamosonline.com/user/create-player
LOGIN_URL=https://agents.ganamosonline.com/login

# Credenciales del agente. Este archivo es solo un ejemplo: los valores reales
# van en .env, que esta en .gitignore y NO se sube al repo.
PANEL_USER=tu-usuario
PANEL_PASS=tu-password

# Cada cuantos segundos consulta la base
POLL_SEGUNDOS=30
